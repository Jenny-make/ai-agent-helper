APP_CONSOLE_ENABLED=true
# Enable RAG only when Milvus is reachable
APP_RAG_ENABLED=false
APP_RAG_TOP_K=4
APP_RAG_SIMILARITY_THRESHOLD=0.0
APP_RAG_MAX_CHARS_PER_DOC=1200

APP_AI_PROVIDER=auto
APP_SYSTEM_PROMPT=You are a helpful customer support assistant. Answer clearly and concisely.
APP_MEMORY_ENABLED=true
APP_MEMORY_MAX_TURNS=6
APP_MEMORY_MAX_CHARS_PER_MESSAGE=1200
APP_MEMORY_PROMPT_RECENT_TURNS=4
APP_MEMORY_MAX_SUMMARY_CHARS=1200
# Optional: configure these to persist conversation memory in MySQL.
# Leave unset for local in-memory development.
SPRING_DATASOURCE_URL=jdbc:mysql://replace-me.mysql.rds.aliyuncs.com:3306/customer_service_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=cs_app
SPRING_DATASOURCE_PASSWORD=replace-me

APP_FEISHU_BASE_URL=https://open.feishu.cn/open-apis
APP_FEISHU_VERIFICATION_TOKEN=replace-me
APP_FEISHU_ENCRYPT_KEY=replace-me
APP_FEISHU_KNOWLEDGE_ENABLED=false
APP_FEISHU_KNOWLEDGE_AUTO_SYNC_ON_STARTUP=false
APP_FEISHU_KNOWLEDGE_CHUNK_SIZE=700
APP_FEISHU_KNOWLEDGE_CHUNK_OVERLAP=120
APP_FEISHU_KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=200
APP_FEISHU_KNOWLEDGE_STATE_FILE=build/feishu-knowledge/sync-state.json
APP_FEISHU_BOT_APP_ID=replace-me
APP_FEISHU_BOT_APP_SECRET=replace-me

SPRING_AI_DEEPSEEK_API_KEY=replace-me
SPRING_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com

SPRING_AI_MINIMAX_API_KEY=replace-me
SPRING_AI_MINIMAX_BASE_URL=https://api.minimax.chat
SPRING_AI_MINIMAX_CHAT_OPTIONS_MODEL=abab6.5g-chat

SPRING_AI_OPENAI_API_KEY=replace-me
SPRING_AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=qwen-max

SPRING_AI_VECTORSTORE_MILVUS_CLIENT_HOST=replace-me
SPRING_AI_VECTORSTORE_MILVUS_CLIENT_PORT=19530
SPRING_AI_VECTORSTORE_MILVUS_DATABASE_NAME=default
SPRING_AI_VECTORSTORE_MILVUS_COLLECTION_NAME=customer_service_knowledge
